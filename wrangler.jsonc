{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bar-demo",
  "main": "src/worker.ts",
  "preview_urls": false,
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "keep_names": true,
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "InvestigationAgent",
        "class_name": "InvestigationAgent"
      },
      {
        "name": "PublicRateLimitAgent",
        "class_name": "PublicRateLimitAgent"
      },
      {
        "name": "ResolutionMemoryAgent",
        "class_name": "ResolutionMemoryAgent"
      }
    ]
  },
  "exports": {
    "InvestigationAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PublicRateLimitAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ResolutionMemoryAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "workflows": [
    {
      "name": "bar-investigation",
      "binding": "INVESTIGATION_WORKFLOW",
      "class_name": "InvestigationWorkflow"
    }
  ],
  "observability": {
    "enabled": true
  }
}
